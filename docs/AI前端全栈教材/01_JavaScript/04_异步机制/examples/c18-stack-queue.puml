@startuml
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 14
skinparam dpi 100
skinparam backgroundColor white
skinparam shadowing false
rectangle "调用栈：尚未结束的调用" as Stack #E3F2FD {
  rectangle "inner\n栈顶，当前执行" as Inner
  rectangle "outer\n等待 inner 返回" as Outer
  rectangle "当前脚本\n等待 outer 返回" as Script
  Inner -down-> Outer : 返回后继续
  Outer -down-> Script : 返回后继续
}
rectangle "任务队列：等待调度的工作" as Tasks #E0F2F1 {
  rectangle "某个定时器回调\n计时已满足，尚未执行" as Timer
}
Timer .left.> Stack : 当前同步执行结束后\n由调度规则选中再执行
@enduml
