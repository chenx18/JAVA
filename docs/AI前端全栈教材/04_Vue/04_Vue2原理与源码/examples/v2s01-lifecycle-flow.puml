@startuml
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 14
skinparam dpi 100
skinparam backgroundColor white
skinparam shadowing false
skinparam ArrowColor #7E93A1
skinparam ArrowThickness 1.4
skinparam ranksep 24
skinparam nodesep 22
hide stereotype
skinparam activity {
  BackgroundColor #E4F5ED
  BorderColor #32A77C
  FontColor #203F36
  DiamondBackgroundColor #FFF0C7
  DiamondBorderColor #D7A034
  FontColor<<hook>> #C84453
  BackgroundColor<<hook>> #FFFFFF
  BorderColor<<hook>> #DF5664
  BackgroundColor<<stage>> #344B61
  BorderColor<<stage>> #344B61
  FontColor<<stage>> #FFFFFF
  BackgroundColor<<caution>> #FFF8E8
  BorderColor<<caution>> #D6B86A
  FontColor<<caution>> #66512F
}
skinparam note {
  BackgroundColor #FFF8E8
  BorderColor #D6B86A
  FontColor #66512F
}

(*) --> "new Vue(options) → _init\n准备配置、实例关系、事件与渲染入口" as init <<stage>>
init -left[#DF5664,dashed]-> "beforeCreate\n实例已存在，Options 状态尚未就绪" as beforeCreate <<hook>>
init --> "initInjections → initState → initProvide\n准备注入、状态与提供给后代的值" as state
state -left[#DF5664,dashed]-> "created\n数据与方法已可用，尚未挂载 DOM" as created <<hook>>

state --> if "有 el 选项？" then
  -->[是] "调用 $mount(el)\n开始挂载流程" as mount
else
  -right->[否] "先保留已初始化实例\n之后手动调用 $mount()，或由父组件挂载" as waitMount <<caution>>
  waitMount --> mount
endif

mount --> if "已有 render？" then
  -->[是] "mountComponent\n准备首次渲染" as mountComponent
else
  -right->[否] if "使用含模板编译器的构建？" then
    -->[是] if "提供了 template？" then
      -->[是] "确定待编译的模板内容\n显式 template 或挂载元素 outerHTML" as template
    else
      -right->[否] "有挂载元素时取其 outerHTML\n无元素则没有可用模板" as outerHTML
      outerHTML --> template
    endif
    template --> if "有合法模板可编译？" then
      -->[是] "compileToFunctions\n得到 render 与静态渲染函数" as compiled
      compiled --> mountComponent
    else
      -right->[否] "检查模板或 render 配置\n无 render 时无法呈现预期界面" as missingRender <<caution>>
    endif
  else
    -right->[否] missingRender
  endif
endif

note right
  运行时构建不现场编译模板。
  缺少 render 时开发模式会警告，
  并使用空 VNode；这是配置排查分支。
end note

mountComponent -left[#DF5664,dashed]-> "beforeMount\n首次渲染 Watcher 求值之前" as beforeMount <<hook>>
mountComponent --> "创建渲染 Watcher，立即首次求值\n_render() 生成 VNode\n_update() → patch 创建组件 DOM" as firstPatch
firstPatch -left[#DF5664,dashed]-> "mounted\n根实例或子组件插入流程调用" as mounted <<hook>>
firstPatch --> "实例已挂载\n保留状态，处理后续交互" as active <<stage>>

active -right-> "相关渲染依赖发生变化\nDep 通知 → Watcher.update()" as notify
notify --> "queueWatcher 按 Watcher ID 去重\nnextTick 安排 flushSchedulerQueue" as queue
queue --> "执行这次组件更新任务" as updateTask
updateTask -right[#DF5664,dashed]-> "beforeUpdate\n已挂载实例的更新开始前" as beforeUpdate <<hook>>
updateTask --> "Watcher.run()\n重新 render → VNode → patch" as patch
patch --> "本批渲染完成\n调度器处理 updated 钩子" as flushed
flushed -right[#DF5664,dashed]-> "updated\n本次 DOM 已更新" as updated <<hook>>
flushed -up->[等待下一次变化] active

active --> "进入 $destroy()\n组件被移除，或代码主动销毁" as destroy
destroy -left[#DF5664,dashed]-> "beforeDestroy\n业务在此主动释放外部资源" as beforeDestroy <<hook>>
destroy --> "解除父子关联，停止组件作用域\n停止 Watcher 并清理依赖" as stopEffects
stopEffects --> "patch(vnode, null)\n执行子树销毁钩子" as destroyTree
destroyTree -left[#DF5664,dashed]-> "destroyed\n组件已退出正常更新流程" as destroyed <<hook>>
destroyTree --> "$off() 等后续事件与引用清理" as finished
finished --> (*)

legend bottom left
  实线：执行流程；红色虚线：在对应阶段调用钩子。
  基线：Vue 2.7.16、浏览器普通挂载、默认异步更新；不含 SSR 水合。
  initState：props → setup（2.7）→ methods → data → computed → watch。
  DOM 更新不代表浏览器已绘制；无关字段变化不一定使组件重新渲染。
  KeepAlive 停用 / 恢复是另一条路径，不在切换时直接进入销毁。
  手动 $destroy() 不保证删除根 DOM，外部引用也不会自动消失。
endlegend
@enduml
